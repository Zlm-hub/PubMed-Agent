# ---- 依赖 ----
node_modules/
backend/.venv/

# ---- 构建产物（可重新生成）----
frontend/dist/
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/vite.config.js.timestamp-*.mjs
*.tsbuildinfo

# ---- 环境变量（含密钥，切勿提交）----
# 用户放在仓库根、充当「全局环境变量」的 .env 内含真实密钥，必须挡住；
# 只放行示例文件。注意顺序：否定规则要写在 .env.* 之后才生效。
.env
.env.*
!.env.example
backend/.env

# ---- 运行时数据 ----
backend/logs/
backend/cache/
backend/data/*.bak*
# 期刊指标 SQLite（可由 scripts/build_metrics_db.py 重新生成；是否随包发布由提交者决定，
# 默认不入库以控制仓库体积，需要「随包发布」时再显式 git add -f）
backend/data/*.db
# 运行期数据库的 WAL / SHM 伴生文件（SQLite 打开时自动生成，绝不属于源码）
backend/data/*.db-wal
backend/data/*.db-shm
# 登录 token 的 HMAC 签名密钥：AUTH_SECRET 未配置时自动生成落盘。
# **这是密钥，任何情况下都不许进仓库**（泄漏即可伪造任意用户的登录态）。
backend/data/auth_secret.key

# ---- 部署包里的运行期数据（deploy/ 目录只提交配置与脚本）----
# 服务器上的 data/cache/logs/certs 是容器挂载卷内容（含客户会话、账号库、证书），
# 属于运行期数据；本机同步到仓库只应带 Dockerfile / compose / 脚本 / 文档。
deploy/data/
deploy/cache/
deploy/logs/
deploy/certs/
deploy/backups/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 本地调试产物（约定：下划线开头，不进仓库、可随时删）----
_*.png
_dom*.html
_*.py

# ---- 本地流水线产物 / Office 临时锁文件 ----
output/
~$*
