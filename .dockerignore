# 版本库与依赖（镜像内重新安装 / 重新构建）
.git
.gitignore
.gitattributes
**/node_modules
backend/.venv
.venv

# 前端构建产物：**不能排除**。
#   · 多阶段 Dockerfile：阶段 1 会重新构建（顺带把旧 dist 覆盖掉，无副作用）
#   · Dockerfile.prebuilt（2G 服务器用）：直接 COPY frontend/dist，排除掉就会构建失败
# 体积只有约 1MB，留在上下文里最省心。
frontend/vite.config.js
frontend/vite.config.d.ts
*.tsbuildinfo

# 密钥：一律不进镜像，运行时通过 env_file / 挂载注入
.env
.env.*
**/.env
**/.env.*
!deploy/.env.example

# 运行时与本地产物
backend/logs
backend/cache
backend/data/*.bak*
# 运行时库（本机积累的检索文献 / 历史会话）：排除，避免把本地数据带进镜像层，
# 同时省掉约 30MB 上下文。容器首次启动会按 schema 自行建表。
backend/data/literature.db*
backend/data/sessions.db*
output
docs
*.docx
_probe_dup.py
_*.png
_dom*.html

# Python 缓存
**/__pycache__
*.py[cod]

# 编辑器 / 系统
.vscode
.idea
.DS_Store
Thumbs.db
