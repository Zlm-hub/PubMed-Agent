# === 凭据（本文件是模板，真实密钥请放在 .env，.env 已被 .gitignore 挡住）===
#
# 放哪：backend/.env 或 仓库根/pubmed-analytics/.env 都行。
# config.py 用 find_dotenv() 从 backend/app/ 逐级向上找，两个位置都能命中。
#
# 变量名两套写法都认，标准名优先：
#   NCBI_API_KEY       ← 也接受 PubMed-APIkey
#   DASHSCOPE_API_KEY  ← 也接受 QW-APIkey
#   DASHSCOPE_BASE_URL ← 也接受 QW-URL 中标着 openAiCompatible 的那条
# 注意：名字写错不会报错，只会「读成空值然后静默降级」，排查时先看这里。

# NCBI E-utilities
# 实测：200 篇时带不带 key 几乎没差（4.60s vs 4.68s）；
#       1000 篇时带 key 可成功（5.29s），不带 key 直接 429 Too Many Requests。
NCBI_API_KEY=
# NCBI_EMAIL 建议填真实邮箱，NCBI 限流时会参考
NCBI_EMAIL=

# 中文综述大模型（OpenAI 兼容网关）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# === 行为开关 ===
# 单次检索上限（前端默认取 200；1000 需配 NCBI key，否则 429）
MAX_RESULTS=1000

# 综述喂给模型的摘要篇数。篇数直接决定 prompt 长度与耗时：
# 30 篇约 3.3 万字符，真实大模型实测 10~40 秒量级；调小可显著提速。
REVIEW_TOP_N=30

# 置 1 则强制走本地拼装的示例综述（不调用大模型）。
# 未配置 DASHSCOPE_API_KEY 时即便不置 1 也会自动降级，响应体带 mock: true。
MOCK_LLM=0

# 中文查询改写（渐冻症 → amyotrophic lateral sclerosis）。
# 仅对含中文的输入生效：L0 查本地映射表（0ms）→ L1 LLM 改写（esearch 试搜护栏）。
# 置 0 关闭后行为与旧版一致（中文词会 0 命中）。改写结果落 literature.db 缓存，同词只翻一次。
QUERY_REWRITE=1

# 一键演示预置关键词（渐冻症走中文改写链路）
PRESETS=Alzheimer,CRISPR cancer,COVID-19 vaccine,渐冻症

# 监控日志（docs/监控日志设计方案.md）：按天轮转双文件
LOG_LEVEL=INFO
# LOG_DIR 默认 backend/logs
LOG_RETENTION_DAYS_APP=14
LOG_RETENTION_DAYS_ERROR=30
