# NCBI E-utilities（可选，配置后限流从 3/s 提到 10/s）
NCBI_API_KEY=
NCBI_EMAIL=

# 阿里云百炼 DashScope（中文综述大模型，OpenAI 兼容）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 检索上限（锁定决策：前 1000 篇）
MAX_RESULTS=1000

# 本地无 key 时置 1 走示例综述（仅用于演示 UI，不调用真实大模型）
MOCK_LLM=0
