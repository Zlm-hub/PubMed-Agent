# 部署配置模板 → 复制为 deploy/.env 后填写。
# deploy/.env 已被 .gitignore 挡住、不会提交；服务器上只需「本目录 + 本文件」，部署包自包含。
#
# 本文件承载两部分：① 访问口令等部署变量  ② NCBI / DashScope 密钥。
# 本机已有仓库根 .env 时，一条命令即可生成（含真实密钥）：
#     { cat ../.env; echo "HOST_PORT=8000"; echo "FREE_TRIAL_LIMIT=3"; echo "ADMIN_CONTACT=QQxxxxxxxx"; } > .env

# ======================= 必填 =======================
# 访问口令：客户打开网址后需先输入它才能使用，防止公开链接被转发后他人白嫖你的 API 密钥。
# 留空 = 不校验（任何人可用）。支持中文（服务端以哈希写入 cookie，不受 cookie 编码限制）。
ACCESS_CODE=
# 口令留空 = 纯账号制（推荐）；如需旧共享口令通道再填值

# ======================= 密钥（从仓库根 .env 拷过来）=======================
NCBI_API_KEY=
NCBI_EMAIL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
LLM_MODEL=qwen-plus

# ======================= 可选 =======================
# 口令 cookie 是否仅走 HTTPS：用 https 访问时置 1，纯 http 保持 0。
ACCESS_COOKIE_SECURE=0
# 对外暴露的宿主机端口（默认 8000）
HOST_PORT=8000
# 一键演示词
PRESETS=阿尔茨海默病,肺癌,高血压,渐冻症
# 单次检索上限（配置上限 1000；实测 1000 会触发 NCBI 限流，建议 200）
MAX_RESULTS=1000
